{
  "name": "@structured-id/ui-core",
  "version": "1.0.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "description": "Shared UI package for StructuredID — proto clients, Vue 3 composables, Pinia stores, components.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/structured-id/ui-core.git"
  },
  "homepage": "https://github.com/structured-id/ui-core",
  "bugs": "https://github.com/structured-id/ui-core/issues",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./proto": {
      "types": "./src/generated/index.d.ts",
      "import": "./src/generated/index.js"
    },
    "./components": {
      "import": "./src/components/index.ts"
    },
    "./quasar": {
      "import": "./src/quasar/index.ts"
    },
    "./browser-vp": {
      "types": "./dist/browser-vp/index.d.ts",
      "import": "./dist/browser-vp/index.js",
      "require": "./dist/browser-vp/index.cjs"
    },
    "./profile": {
      "import": "./src/profile/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "generate": "buf generate --template buf.gen.yaml",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "yarn generate && yarn build"
  },
  "dependencies": {
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "libphonenumber-js": "^1.12.39"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.0",
    "@protobuf-ts/plugin": "^2.11.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-dom": "^3.5.31",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9",
    "jsdom": "^29.0.1",
    "pinia": "^2.1.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^1.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vue-tsc": "^2.0.0"
  },
  "peerDependencies": {
    "pinia": "^2.1.0",
    "quasar": "^2.17.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "quasar": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.12.0",
  "license": "AGPL-3.0-only"
}
