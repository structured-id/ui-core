{
  "name": "@structured-id/ui-core",
  "version": "2.0.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "description": "Shared UI package for StructuredID: Vue 3 composables, Pinia stores and components over the @structured-id/proto clients.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/structured-id/ui-core.git"
  },
  "homepage": "https://github.com/structured-id/ui-core",
  "bugs": "https://github.com/structured-id/ui-core/issues",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./components": {
      "import": "./src/components/index.ts"
    },
    "./quasar": {
      "import": "./src/quasar/index.ts"
    },
    "./profile": {
      "import": "./src/profile/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "@structured-id/proto": "^0.1.1",
    "libphonenumber-js": "^1.13.15"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-dom": "^3.5.43",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "pinia": "^4.0.3",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "pinia": "^4.0.3",
    "quasar": "^2.17.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "peerDependenciesMeta": {
    "quasar": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.14.1",
  "license": "AGPL-3.0-only"
}
